# Git LFS: only for NEW large files that must live in the repo.
# Existing committed data files stay as they are (no history rewrite).
# Prefer references (docs/data-references.md) over committing raw files; see that doc.
data/large/** filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.pbf filter=lfs diff=lfs merge=lfs -text
